# ====================================================================
# TAWZOON NEXUS - ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and configure values for your environment.
# ====================================================================

# Port for the HTTP server (default is 3000)
PORT=3000

# Base URL of the deployed application (used for links, callbacks, and media URLs)
APP_URL="http://localhost:3000"

# Node Environment ('development' or 'production')
NODE_ENV="production"

# Master Administrator Credentials
ADMIN_EMAIL="mdshaali9516@gmail.com"
ADMIN_PASSWORD="TawzoonNexus@9516"

# Gemini AI API Key (required for AI marketing copy, product descriptions, and ad generators)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional: Firebase / Firestore Cloud Database Sync
# Note: The application operates independently with local data persistence in /data/store.json.
# If you want to connect to Firebase Firestore & Cloud Storage, specify either FIREBASE_CONFIG or individual keys below:
# FIREBASE_CONFIG='{"projectId":"your-project","apiKey":"AIza...","firestoreDatabaseId":"(default)","storageBucket":"your-project.firebasestorage.app"}'
# FIREBASE_PROJECT_ID="your-project-id"
# FIREBASE_API_KEY="your-api-key"
# FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
# FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
